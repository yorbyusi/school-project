--- !u!114 &22569041
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 22569039}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92996890504519f4ab6a280bf0e1912d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  introCanvas: {fileID: 1380786689}
  introText: {fileID: 151563011}
  typewriterSpeed: 0.04
  introDelay: 0.5
  introMessage: "Toleransi itu penting karena kita semua berbeda. \nDi sekolah, kita
    harus saling menghormati teman yang punya suku, agama, atau budaya berbeda. \nToleransi
    membantu kita tidak membuli dan lebih memahami teman. \nDengan toleransi, kelas
    jadi lebih damai. Yuk, belajar sabar dan menerima perbedaan!"
  quizCanvas: {fileID: 22569044}
  questionText: {fileID: 1455391693}
  answersParent: {fileID: 1678546358}
  answerPrefab: {fileID: 6756059663052260932, guid: 0b817966ed15e4a4aa32ce7245dac298, type: 3}
  timerText: {fileID: 1106428810}
  timeLimit: 20
  pointsPerCorrect: 5
  quizzes:
  - question: Apa itu toleransi?
    answers:
    - Menghargai perbedaan
    - Menghindari teman
    - Membuli teman
    - Tidak peduli dengan teman
    correctIndex: 0
  - question: Kenapa kita harus menghormati teman yang berbeda?
    answers:
    - Agar kelas damai
    - Agar kita bisa bermain lebih lama
    - Agar kita bisa mengalahkan teman
    - Agar teman tidak marah
    correctIndex: 0
  - question: Bagaimana toleransi membantu kita di sekolah?
    answers:
    - Membantu kita bermain lebih banyak
    - Membantu kita tidak membuli teman
    - Membuat kita bisa lebih cepat pulang
    - Membuat kita lebih pintar
    correctIndex: 1
  - question: Apa yang terjadi jika kita tidak toleransi di kelas?
    answers:
    - Kelas jadi damai
    - Kelas jadi berantakan
    - Kelas jadi lebih menyenangkan
    - Teman jadi lebih ramah
    correctIndex: 1
  - question: Apa yang bisa kita lakukan untuk lebih sabar dan menerima perbedaan?
    answers:
    - Membuli teman
    - Belajar sabar dan mengerti
    - Menghindari teman yang berbeda
    - Tidak berbicara dengan teman
    correctIndex: 1
  popupPanel: {fileID: 1401333106}
  popupText: {fileID: 304013993}
  doneMessage: Wah.. Kamu hebat! Ayo lanjutkan tantangan berikutnya!
  onQuizFinished:
    m_PersistentCalls:
      m_Calls: []
